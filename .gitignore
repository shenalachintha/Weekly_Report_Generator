# =====================================================================
# .gitignore for Weekly Report Generator (ASP.NET Core & React / Vite)
# =====================================================================

# ---------------------------------------------------------------------
# .NET / C# / Visual Studio Build Artifacts
# ---------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog

# Visual Studio & IDEs
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.resharper
*.DotSettings.user

# Test results and crash dumps
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
*.dmp
*.crash

# NuGet
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# ---------------------------------------------------------------------
# Node.js / React (JSX) / Vite
# ---------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
frontend/dist/
dist-ssr/
*.local

# Environment variables
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Editor directories and caches
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ---------------------------------------------------------------------
# SQL Server & Database Local Files
# ---------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------
# Operating System Files
# ---------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------------------------------------------------------------------
# Temporary logs
# ---------------------------------------------------------------------
*.log
backend/appsettings.Development.json
